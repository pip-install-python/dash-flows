# Environment knobs for the flows.2plot.dev docs site (run.py).
# Copy to `.env` for local development — `run.py` calls load_dotenv() at
# import time. Everything is optional: with nothing set the app boots in its
# degraded posture (dormant traffic reporter, unwired bulletin, local
# analytics ledger). tests/conftest.py pins these EMPTY so the secretless
# suite always exercises that posture; see the note there before adding keys.

# ---------------------------------------------------------------------------
# 2plot network wiring (production values live in render.yaml / the Render
# dashboard — see the Blueprint-vs-live-service warning at the top of it)
# ---------------------------------------------------------------------------
# DASH_BACKEND=flask
# APP_BASE_URL=https://flows.2plot.dev
# This app's ONE short id on every hub surface: its network-directory key,
# never the PyPI package name.
# SATELLITE_APP_KEY=flows
# AD_APP_ID=flows
# Shared HMAC secret every satellite holds — no secret, no traffic reporting;
# the app runs on unaffected.
# CROSS_APP_WEBHOOK_SECRET=
# NETWORK_BULLETIN_URL=https://2plot.dev/api/network/bulletin
# Point the analytics ledger at storage that survives restarts (production
# mounts a disk at /var/data — see render.yaml).
# TRAFFIC_ANALYTICS_FILE=/var/data/visitor_analytics.json
# SATELLITE_REPORT_INTERVAL_S=1800

# ---------------------------------------------------------------------------
# Corpus document tiers (lib/page_tiers.py; registered in run.py)
# ---------------------------------------------------------------------------
# Access tier for the tiered corpus documents served by dash-improve-my-llms
# >= 2.4.0: /llms-small.txt (compact briefing) and /llms-full.txt (every
# page's prose in one fetch). Values: public | auth | admin | hidden.
# Unset = public — the network's standing policy is that discovery documents
# stay free; these knobs exist so the 402 experiment can tighten the full
# corpus per-satellite without a redeploy of anything else. The hub's
# page-tier ceilings can also tighten either network-wide (a satellite can
# never loosen below the hub). Inert on older package versions.
# LLMS_SMALL_TIER=public
# LLMS_FULL_TIER=public

# ---------------------------------------------------------------------------
# The interactive sign-in gate (shipped DARK — see render.yaml)
# ---------------------------------------------------------------------------
# Default tier for pages that declare none in their frontmatter.
#   public  every page falls open (the shipped posture)
#   auth    the flip: anonymous visitors get the sign-in card
# Declared EXPLICITLY in render.yaml even while public, because run.py keys
# lib.access.configure(force=...) off its presence — the verdict plumbing has
# to be live BEFORE the flip, not on it.
# PAGE_DEFAULT_TIER=public

# Do the machine twins (/llms.txt, /<page>/llms.txt, the crawler document)
# stay open on pages the interactive gate closes? UNSET network-wide until
# phase 4 — machine surfaces stay public through the data window by decision.
# LLMS_PUBLIC_DEFAULT=

# Tier for the control board's own overrides store. Must live on the mounted
# disk or every deploy resets the board; lib/page_visibility.py warns at boot.
# PAGE_VISIBILITY_FILE=/var/data/page_visibility.json

# Who may reach /admin/control-board. Comma-separated; fails CLOSED unset.
# ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Clerk satellite auth (dash-clerk-auth, vendored)
# ---------------------------------------------------------------------------
# With NO keys set, lib/auth.py registers nothing and the site runs fully
# public — the capability ships, the login wall does not. In production these
# arrive via the shared env group `2plot-clerk-satellite`.
#
# Leave CLERK_IS_SATELLITE false locally: Clerk rejects satellites on
# localhost.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SIGN_IN_URL=https://2plot.ai/onboarding
# CLERK_IS_SATELLITE=false
# CLERK_SATELLITE_DOMAIN=flows.2plot.dev
# A DESTINATION, not a flag. Unset strands authenticated users on the
# primary; a truthy non-URL gives a 404ing Sign In button. lib/auth.py
# boot-guards both — the absence of its [auth] WARNING lines is the check.
# CLERK_SATELLITE_SIGN_IN_REDIRECT=https://2plot.ai/onboarding
# Per-service and UNIQUE. Never shared between hosts.
# SESSION_SECRET=
